# Core pipeline paths
DATA_DIR=data
INPUT_DIR=data/raw

# Local offline LLM runtime
LLM_PROVIDER=local
LOCAL_MODEL_PATH=./models/qwen2.5-14b-q4.gguf
LOCAL_LLM_N_CTX=8192
LOCAL_LLM_N_GPU_LAYERS=-1
LOCAL_LLM_MAX_TOKENS=2048
LOCAL_LLM_TEMPERATURE=0.0

# Embeddings/vector grouping
EMBEDDING_MODEL=
VECTOR_STORE=faiss
SIMILARITY_THRESHOLD=0.8
SEGMENT_SIZE_PAGES=2
